# Token da API do Zaple. Fica APENAS no servidor — nunca prefixe com
# NEXT_PUBLIC_, porque ele dá acesso a todos os contatos e painéis da empresa.
ZAPLE_TOKEN=
ZAPLE_BASE_URL=https://api.wts.chat

# Painel de visitas no Zaple.
ZAPLE_PANEL_ID=

# Postgres do Supabase.
#
# DATABASE_URL: o "Transaction pooler" (porta 6543). É a que o app usa em
# produção — serverless abre e fecha conexão o tempo todo, e o pooler é o que
# impede isso de estourar o limite do projeto.
DATABASE_URL=
#
# DIRECT_URL: a conexão direta (porta 5432). Usada só pelas migrações, porque
# o pooler de transação não sustenta bem DDL.
DIRECT_URL=

# Segredo de assinatura do cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Conexões por instância. Deixe em branco em produção (padrão 3).
# Em desenvolvimento com o Postgres embarcado (scripts/banco-local.mts), use 1:
# o PGlite serve tudo por uma conexão e multiplexa mal consultas concorrentes.
DB_POOL_MAX=
